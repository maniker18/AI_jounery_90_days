import os
from pathlib import Path

# See ALL your environment variables that contain 'HOME' or 'USER'
print("Environment variables with HOME or USER:")
for key, value in os.environ.items():
    if 'HOME' in key.upper() or 'USER' in key.upper():
        print(f"  {key} = {value}")

# Compare different methods
print(f"\nos.environ.get('HOME'): {os.environ.get('HOME')}")
print(f"os.environ.get('USERPROFILE'): {os.environ.get('USERPROFILE')}")
print(f"os.path.expanduser('~'): {os.path.expanduser('~')}")
print(f"Path.home(): {Path.home()}")



